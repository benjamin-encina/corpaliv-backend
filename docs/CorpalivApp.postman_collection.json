{
  "info": {
    "name": "CorpalivApp - Backend",
    "description": "Pruebas de los 3 microservicios (auth 8083, oportunidades 8081, aportes 8082). Ejecutar con la colección completa (Run) o la carpeta 1 primero para obtener el token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "auth",
      "value": "http://localhost:8083"
    },
    {
      "key": "oportunidades",
      "value": "http://localhost:8081"
    },
    {
      "key": "aportes",
      "value": "http://localhost:8082"
    },
    {
      "key": "jwtAdmin",
      "value": ""
    },
    {
      "key": "oportunidadId",
      "value": ""
    },
    {
      "key": "aporteId",
      "value": ""
    },
    {
      "key": "postulacionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. auth-service",
      "item": [
        {
          "name": "1. Login administrador (200 + guarda token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Devuelve un token\", function () { pm.expect(json.token).to.be.a(\"string\"); pm.expect(json.token.length).to.be.above(20); });",
                  "pm.test(\"Rol ADMINISTRADOR\", function () { pm.expect(json.rol).to.eql(\"ADMINISTRADOR\"); });",
                  "pm.collectionVariables.set(\"jwtAdmin\", json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{auth}}/api/auth/login",
              "host": [
                "{{auth}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Ejecutar primero: guarda el token en la variable de colección {{jwtAdmin}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@corpaliv.cl\",\n  \"clave\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "2. Login con clave incorrecta (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
